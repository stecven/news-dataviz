{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pagelayout.json（PageLayoutDoc v1.0）",
  "type": "object",
  "description": "可编辑报纸版式契约的唯一机器可读定义（draft 2020-12 的一个受限子集，只允许 loop/schema_check.py::SUPPORTED_KEYWORDS 里的关键字）。它是「目标 1.0」的规格，不是对历史样本的描述：老样本缺 version / theme / images，今天必然校验失败（Spec §7 V5）。取值口径故意只卡结构：图元几何的权威定义在 Spec §5.5 与 loop/thermo_shape.py、loop/scaffold.py，schema 复述几何语义就会漂移。",
  "required": [
    "version",
    "theme",
    "width_in",
    "height_in",
    "margin_in",
    "gutter_in",
    "column_count",
    "column_gutter_in",
    "rows",
    "cards",
    "blocks",
    "images"
  ],
  "properties": {
    "version": {
      "type": ["string", "null"],
      "description": "契约版本，新样本 \"1.0\"；老样本没有这个键（Spec §5.6 / D9 / D12）。"
    },
    "theme": {
      "type": ["object", "null"],
      "description": "主题 = loop/palette.py::summary() 的原样产物（Spec §5.6 / D11）。"
    },
    "width_in": {
      "type": "number"
    },
    "height_in": {
      "type": "number"
    },
    "margin_in": {
      "type": "number"
    },
    "gutter_in": {
      "type": "number"
    },
    "column_count": {
      "type": "integer"
    },
    "column_gutter_in": {
      "type": "number"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    }
  },
  "$defs": {
    "page": {
      "title": "PageSpec（卡片内的 spec）",
      "description": "单卡层：Relative coordinates only —— elements 的坐标相对卡片左上角（Spec §5.4 / 约束 C2）。键集取自 loop/models.py::PageSpec 的 asdict()，外加 1.0 新增的 chart；required 与 PageSpec.from_dict（loop/models.py:70-74）一致 —— 它对这 5 个键是硬取，契约若放过一份结构性残缺的 spec，消费端（JS 渲染器）就会在运行时炸。",
      "type": "object",
      "required": ["width_in", "height_in", "chart_key", "chart_title", "scale"],
      "properties": {
        "width_in": {
          "type": "number"
        },
        "height_in": {
          "type": "number"
        },
        "chart_key": {
          "type": "string"
        },
        "chart_title": {
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "semantic_tags": {
          "type": "array"
        },
        "constraints": {
          "type": "array"
        },
        "layout": {
          "type": "object"
        },
        "content_bbox": {
          "type": ["array", "null"],
          "description": "包框之前，数据图形原来占的那块 [x, y, w, h]（Spec §5.3）。"
        },
        "frame_bbox": {
          "type": ["array", "null"],
          "description": "包框之后的框 [x, y, w, h]（Spec §5.3）。"
        },
        "chart": {
          "type": ["object", "null"],
          "description": "语义层（1.0 新增，可空）：{kind, series, encoding}。渲染器必须能只靠 elements 画图（D3）。"
        }
      }
    },
    "element": {
      "title": "ElementSpec",
      "description": "图元层是硬契约。只硬卡 id/type/role/x_in/y_in/w_in/h_in；geometry 与 binding 一律放行 —— 各图元的 geometry 键由 Spec §5.5 与 loop/thermo_shape.py、loop/scaffold.py 定义，schema 的职责是卡「结构」而不是复述「几何语义」，复述就会漂移。",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "x_in", "y_in", "w_in", "h_in"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "description": "图元词汇表，7 + 1 个（Spec §5.5）：rect / ellipse / arc / text / ticks / outline / image / chart。",
          "enum": ["rect", "ellipse", "arc", "text", "ticks", "outline", "image", "chart"]
        },
        "role": {
          "type": "string"
        },
        "x_in": {
          "type": "number"
        },
        "y_in": {
          "type": "number"
        },
        "w_in": {
          "type": "number"
        },
        "h_in": {
          "type": "number"
        },
        "fill": {
          "type": ["string", "null"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "binding": {
          "type": ["object", "null"],
          "description": "数据点 {value, label, ...}；键集由各图元自定，故意放行。"
        },
        "geometry_expr": {
          "type": ["string", "null"],
          "description": "声明式求解表达式，只作审计留痕，不解析（Spec §1.3）。"
        },
        "geometry": {
          "type": ["object", "null"],
          "description": "故意宽松：复合图元的求解结果（align / lines / cx / cy / R / start_angle / end_angle / count / len / thick / ...）。权威键集在 Spec §5.5 与 loop/thermo_shape.py、loop/scaffold.py，这里不做 oneOf 分支 —— 那会让 schema 与校验器都膨胀到没人维护。"
        },
        "image_path": {
          "type": ["string", "null"],
          "description": "type == \"image\" 时引用的磁盘文件路径（相对项目根）。"
        },
        "lines": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          },
          "description": "1.0 新增（Spec §5.6 / D10）：卡片内文本的完整折行结果，不截断到 4 行。"
        },
        "font_pt": {
          "type": ["number", "null"],
          "description": "1.0 新增（Spec §5.6 / D10）：该文本元素的实际字号。"
        },
        "editable": {
          "type": ["boolean", "null"],
          "description": "1.0 新增（Spec §5.6）：缺省按 type 推（ticks / outline 缺省不可单独选中，随宿主）。"
        }
      }
    },
    "scale": {
      "title": "Scale",
      "description": "卡片内比例尺（loop/models.py::Scale）。factor 与 domain 可选，缺省 None 以保持老 pagespec.json 可读。",
      "type": "object",
      "properties": {
        "v_max": {
          "type": "number"
        },
        "h_in": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "factor": {
          "type": ["number", "null"]
        },
        "domain": {
          "type": ["array", "null"]
        }
      }
    },
    "card": {
      "title": "PlacedCard",
      "description": "排好位置的卡片（loop/layout.py::PlacedCard.to_dict 的键集）。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "x_in": {
          "type": "number"
        },
        "y_in": {
          "type": "number"
        },
        "w_in": {
          "type": "number"
        },
        "h_in": {
          "type": "number"
        },
        "row": {
          "type": "integer"
        },
        "column_span": {
          "type": "integer"
        },
        "spec": {
          "$ref": "#/$defs/page"
        }
      }
    },
    "block": {
      "title": "PlacedBlock",
      "description": "排好位置的文本块（loop/layout.py::PlacedBlock.to_dict 的键集）。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "align": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "x_in": {
          "type": "number"
        },
        "y_in": {
          "type": "number"
        },
        "w_in": {
          "type": "number"
        },
        "h_in": {
          "type": "number"
        },
        "row": {
          "type": "integer"
        },
        "column_span": {
          "type": "integer"
        },
        "columns": {
          "type": "integer"
        },
        "column_gutter_in": {
          "type": "number"
        },
        "lines": {
          "type": "array",
          "description": "折好的行（全量）。"
        },
        "line_groups": {
          "type": "array",
          "description": "块内分栏后的行分组，len(...) == columns；元素本身是行列表，故不细化 items。"
        }
      }
    },
    "image": {
      "title": "PlacedImage",
      "description": "排好位置的插图（loop/layout.py::PlacedImage.to_dict 的键集）。asset_id / tag / semantic 是 ImageBlock 上的可选溯源字段，可以是 null。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "align": {
          "type": "string"
        },
        "x_in": {
          "type": "number"
        },
        "y_in": {
          "type": "number"
        },
        "w_in": {
          "type": "number"
        },
        "h_in": {
          "type": "number"
        },
        "row": {
          "type": "integer"
        },
        "column_span": {
          "type": "integer"
        },
        "asset_id": {
          "type": ["integer", "null"]
        },
        "tag": {
          "type": ["string", "null"]
        },
        "semantic": {
          "type": ["string", "null"]
        },
        "rect": {
          "type": "array",
          "description": "盒内真实绘制矩形 [dx, dy, w, h]（永不变形、居中留白），渲染时用它，不要拉伸外盒（Spec §5.2）。"
        }
      }
    },
    "row": {
      "title": "LayoutRow",
      "description": "整版的一行（loop/layout.py:819-832 的键集）：kind 取值 text / cards / row，其余是行内成员名字。",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "y_in": {
          "type": "number"
        },
        "h_in": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
